# ==========================================
# OFFICEFLOW SPECIFIC (PROJECT DATA)
# ==========================================
# Tuyệt đối không push file upload/download của user lên Git
backend/storage/uploads/*
backend/storage/outputs/*
!backend/storage/uploads/.gitkeep
!backend/storage/outputs/.gitkeep

# Bỏ qua database cục bộ (nếu dùng SQLite cho MVP)
backend/*.sqlite3
backend/*.db