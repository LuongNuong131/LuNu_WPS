# ==========================================
# PYTHON / FASTAPI (BACKEND)
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Môi trường ảo (Virtual Environments)
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

